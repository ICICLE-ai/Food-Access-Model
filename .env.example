# Database config
DB_NAME="database_name"
DB_USER="database_user"
DB_PASS="database_password"
DB_HOST="localhost"
DB_PORT=1234 #example port

# Instance config
PLACE_NAME="Place Name, State, Country" 
FIPSCODE=12345 #example FIPS code
YEAR=2022 #example year
CENTER_LAT=0.0 #example latitude
CENTER_LON=0.0 #example longitude
INCLUDE_OSM_STORES=False
STORES_CSV="stores.csv" #example stores csv file (LEAVE BLANK IF NONE)

# Number of worker processes to run
NUMBER_PROCESSES=8 #example number

#API config
APIKEY="an_api_key"

# Optional per-request user scoping (#102).
# Clients may send `Authorization: Bearer <token>` on any API call. With no
# header, the request sees the shared public pool (simulation_instances where
# owner_id IS NULL) and behaves exactly like the pre-scoping backend -- no env
# var is needed. With a header, the token is verified via JWKS (see JWT_*
# below) and the request sees ONLY instances owned by that user; a token that
# fails verification is treated as no-token.
#
# Verification config. JWT_JWKS_URL unset -> verification disabled; every
# token is ignored and all requests fall through to the public pool.
# JWT_JWKS_URL set -> tokens are verified against that JWKS; invalid tokens
# are rejected rather than trusted. Issuer and audience pinning are opt-in.
# For the ICICLE/Tapis deployment, point JWT_JWKS_URL at the Tapis JWKS and
# set JWT_USER_CLAIM=username (Tapis puts the user id there, not in `sub`).
# JWT_JWKS_URL=https://your-oidc-provider.example/.well-known/jwks.json
# JWT_ISSUER=https://your-oidc-provider.example/
# JWT_AUDIENCE=feast-backend
# JWT_USER_CLAIM=sub         # Tapis uses "username"
# JWT_ALGORITHMS=RS256       # comma-separated; defaults to RS256