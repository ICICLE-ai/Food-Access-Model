{
  "openapi": "3.1.0",
  "info": {
    "title": "Food-Access-Model API",
    "description": "Backend API for the Food Equity Access Simulation Technology (FEAST) agent-based model. Simulates how changes in the food retail landscape affect household food access. Endpoints are grouped under /api.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/simulation-instances": {
      "get": {
        "tags": [
          "ABM"
        ],
        "summary": "Get Simulation Instances",
        "description": "Get the simulation instances visible to the caller.\n\nNo ``Authorization: Bearer`` header returns the shared public pool\n(``owner_id IS NULL``). A valid token returns ONLY instances owned by\nthat caller -- public instances are NOT included.\n\nReturns:\n    dict: A dictionary containing a list of simulation instances.",
        "operationId": "get_simulation_instances_api_simulation_instances_get",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "ABM"
        ],
        "summary": "Create Simulation Instance",
        "description": "Create a new simulation instance.\n\nThe caller's user id (from ``Authorization: Bearer <token>``) is stamped\ninto ``owner_id``; a no-token caller creates a public instance\n(``owner_id`` NULL), matching the pre-#102 shared-pool behavior.\n\nParameters:\n    name (str, optional): The name of the simulation instance.\n    description (str, optional): A description of the simulation instance.\n    household_limit (int, optional): The maximum number of households to generate for the simulation instance.\n\nReturns:\n    dict: A dictionary containing the details of the created simulation instance.",
        "operationId": "create_simulation_instance_api_simulation_instances_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_simulation_instance_api_simulation_instances_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
